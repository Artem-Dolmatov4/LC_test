# Скопировать в .env и заполнить. Makefile подхватывает этот файл сам
# (`-include .env`), отдельно экспортировать ничего не нужно. При запуске
# модулей напрямую, минуя make: `set -a && source .env && set +a`.

# Обязателен для шага 4 (индекс) — плотная нога voyage-context-4.
VOYAGE_API_KEY=

# Обязателен для шагов 5 (синтетика корзины) и 6 (ответы с цитатами) —
# deepseek-v4-pro.
DEEPSEEK_API_KEY=

# Опционален. Нужен только для второй, не прогнанной до конца плотной ноги
# (text-embedding-v4 через DashScope) — см. REPORT.md §5.
DASHSCOPE_API_KEY=
